# STEP W11: Cron-based Scheduler configuration (local server time)
# Trigger system entry point with explicit job_type:
#   python -m backend.run_scheduled_job --job-type <...>
#
# Usage:
# - cd into repo root before cron setup
# - replace /path/to/python with your interpreter (venv recommended)
#
# Daily -> 2 AM -> auto job
0 2 * * * cd /path/to/Leadpilot && /path/to/python -m backend.run_scheduled_job --job-type daily_auto >> sessions/job_logs/cron_daily.log 2>&1
#
# Friday -> 3 AM -> heavy job
0 3 * * 5 cd /path/to/Leadpilot && /path/to/python -m backend.run_scheduled_job --job-type friday_heavy >> sessions/job_logs/cron_friday.log 2>&1
#
# Saturday -> 10 AM -> LinkedIn job (manual assist)
0 10 * * 6 cd /path/to/Leadpilot && /path/to/python -m backend.run_scheduled_job --job-type saturday_linkedin >> sessions/job_logs/cron_saturday.log 2>&1
#
# Sunday -> 6 PM -> report job
0 18 * * 0 cd /path/to/Leadpilot && /path/to/python -m backend.run_scheduled_job --job-type sunday_report >> sessions/job_logs/cron_sunday.log 2>&1
