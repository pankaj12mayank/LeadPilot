# --- App ---
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
# Vite dev server origin (merged into CORS when CORS_ORIGINS is not "*")
FRONTEND_URL=http://localhost:5173
# JSON API mount (default /api). Health stays at GET /health ; branding files stay at /branding/*
API_ROOT_PATH=/api

# --- Scraper (Playwright) ---
SCRAPER_DELAY_MIN_SECONDS=3
SCRAPER_DELAY_MAX_SECONDS=5
SCRAPER_MAX_LEADS_DEFAULT=20
SCRAPER_MAX_LEADS_HARD_CAP=50
SCRAPER_MANUAL_LOGIN_DEFAULT_SECONDS=180
# Max profiles to open when ``profile_contact_enrich`` is true (LinkedIn public mailto/tel).
SCRAPER_PROFILE_ENRICH_CAP=8

# --- Lead scoring (optional industry bonus for ``industry_match`` factor) ---
# SCORING_BENCHMARK_INDUSTRY=software

# --- Storage ---
STORAGE_MODE=csv
CSV_FILE_PATH=data/leads.csv
SQLITE_DB_PATH=database/leads.db
POSTGRES_DSN=

# --- API meta DB (users, history, SQLAlchemy outreach/sessions/settings tables) ---
API_META_DB_PATH=database/api_meta.db

# --- Monorepo dirs ---
EXPORTS_DIR=exports
SESSIONS_DIR=sessions
LOGS_DIR=logs

# Optional: where uploaded logo/favicon files are stored (default: ``storage/branding`` under repo root)
# BRANDING_UPLOAD_DIR=storage/branding

# --- Auth (MVP: local JWT) ---
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Admin console (/admin) — separate from app users; both required to enable admin login ---
# Copy these lines into a real `.env` file next to `config.py` (repo root), then restart the API.
# Values in `frontend/.env` are NOT read by Python — admin login will fail if ADMIN_* is only there.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin@12

# --- AI (Ollama) ---
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3
USE_OLLAMA=true
FREE_API_MODE=false
# Default: backend/prompts (repo root). Override if you host templates elsewhere.
PROMPTS_DIR=

# Message pack generator (retries, timeouts, per-family model tags)
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_MODEL_LLAMA3=llama3
OLLAMA_MODEL_MISTRAL=mistral
OLLAMA_MODEL_DEEPSEEK=deepseek-r1

# --- Optional API keys ---
API_KEYS=

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDER_NAME=Lead Engine
SENDER_EMAIL=
EMAIL_SIGNATURE=

# --- Frontend (Vite) — optional frontend/.env ---
# Dev: leave unset to use baseURL /api + Vite proxy. Prod / Docker: browser-reachable API (include /api).
# VITE_API_BASE_URL=http://localhost:8000/api

# --- Safe manual capture (Playwright + sqlite3) — run: ``python backend\main.py`` or ``python -m backend.main`` ---
# Defaults resolve under the repo root next to ``config.py``.
# SAFE_CAPTURE_DB_PATH=database/safe_leads.db
# SAFE_CAPTURE_PROFILE_DIR=sessions/playwright_user_data/safe_capture
# SAFE_CAPTURE_CSV_PATH=exports/safe_leads.csv
# SAFE_CAPTURE_LOCK_PATH=sessions/safe_capture.lock

# --- Optional: Selenium LinkedIn scraper + leadpilot pipeline (run from repo root) ---
# Use root ``.env`` and/or ``scraper.env`` (``scraper_core`` loads both: ``.env`` first, then ``scraper.env`` overrides).
# Push into this API: set LNN_BASE_URL to your LeadPilot JSON prefix (same as API_ROOT_PATH), e.g. http://127.0.0.1:8000/api
# LNN_BASE_URL=http://127.0.0.1:8000/api
# LNN_API_TOKEN=
# LNN_IS_ADMIN=0
# LNN_WORKSPACE_ID=1
# LNN_PUSH=0
