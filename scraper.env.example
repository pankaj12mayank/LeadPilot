# Copy to scraper.env (same folder as scraper_core.py / config.py) — optional; easy to see in Explorer.
# Load order when running Selenium tools: .env first, then scraper.env (later file wins on duplicate keys).

# --- Chrome ---
# ATTACH_EXISTING_CHROME=0 (recommended): Selenium opens Chrome — no port 9222, one window for the run.
# ATTACH_EXISTING_CHROME=1: you start Chrome with --remote-debugging-port first; preflight checks 127.0.0.1:9222.
# Optional: CHROME_USER_DATA_DIR=... to reuse a profile in launch mode (keeps LinkedIn login between runs).
# Session *metadata* (last successful run time) is stored in sessions/linkedin_session_cache.json — warn after N days if you have not had a good capture. Default 7 (≈ weekly re-check). For ~7 weeks: 49
# LEADPILOT_LINKEDIN_SESSION_DAYS=7
ATTACH_EXISTING_CHROME=0
REMOTE_DEBUG_PORT=9222
# CHROME_USER_DATA_DIR=D:\selenium\li_profile
# START_URL=https://www.linkedin.com/search/results/people/

# --- Scrape: how many profiles ---
MAX_LEADS=20
MAX_LEADS_CAP=500
ASK_MAX_LEADS=0

# --- Delays (seconds, random min–max) — default 3–7; raise for extra safety) ---
DELAY_MIN=3
DELAY_MAX=7
# Seconds after window.open on profile/company (default 1.4)
# PROFILE_TAB_SETTLE=1.4
# Scroll between search result pages (each scroll step)
# SCROLL_PAGE_DELAY_MIN=0.75
# SCROLL_PAGE_DELAY_MAX=1.45
# Retries on WebDriverException per profile (default 3)
# PROFILE_SCRAPE_RETRIES=3

# --- Output (Excel) ---
LEADS_FILE=linkedin_leads.xlsx

# --- AI (Problem + Solution: ollama | api | none) ---
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Run checks ---
SKIP_PREFLIGHT=0
# 0 = lenient (default): Ollama / Chrome smoke can warn; lead scraper still runs. 1 = fail on those.
LEADPILOT_STRICT_PREFLIGHT=0
# pipeline (python -m backend.leadpilot): after Chrome opens, wait for People search (no Enter in non-TTY / API runs).
# LEADPILOT_SKIP_READY_PROMPT=0
# Initial pause before the scraper tries to read the page; API default is 60s. Combine with sign-in wait below.
# LEADPILOT_READY_DELAY_SECONDS=60
# How long to poll for login / 2FA / LinkedIn challenge to clear before giving up (default 600s).
# LEADPILOT_LOGIN_MAX_WAIT_SECONDS=600
# 1 = if 0 leads (still logging in or empty results), do not auto-close launch-mode Chrome (default 1).
# LEADPILOT_NO_QUIT_ON_ZERO_ROWS=1
# 0 = never call driver.quit() in launch mode (always leave the browser open).
# LEADPILOT_QUIT_CHROME_AFTER_RUN=1
# After Excel export, insert rows into app Leads table (SQLite). 0 = Excel only.
LEADPILOT_INGEST_TO_CRM=1
# --- Lead capture timing (Selenium v3) ---
# First tab on launch: feed (not a pre-filled search). Set 1 to open People search immediately (old behavior).
# LEADPILOT_OPEN_PEOPLE_ON_LAUNCH=0
# LEADPILOT_INITIAL_URL=https://www.linkedin.com/feed/
# After login, auto-jump from feed to People search (usually leave 0; you run search yourself).
# LEADPILOT_AUTO_OPEN_PEOPLE_SEARCH=0
# Second gate: no /in/ links until this step. TTY: press Enter. No TTY: wait N seconds (API uses SKIP + delay).
# LEADPILOT_SKIP_START_CAPTURE_PROMPT=0
# LEADPILOT_START_CAPTURE_DELAY_SECONDS=90

# --- Playwright pipeline (python main.py): website enrichment (blog/careers/ads heuristics) + signals + scoring ---
# LEADPIPELINE_WEBSITE_ENRICHMENT=1
# LEADPIPELINE_ENRICH_DELAY_MIN=0.25
# LEADPIPELINE_ENRICH_DELAY_MAX=0.9
# Set to 1 to skip the headless Chrome+WebDriver smoke test in preflight (e.g. machine has no Chrome).
# LEADPILOT_SKIP_CHROME_SMOKE=0

# --- Push into LeadPilot API (start API first: run.bat or dev_server) ---
# LNN_BASE_URL=http://127.0.0.1:8000/api
# LNN_API_TOKEN=
# LNN_IS_ADMIN=0
# LNN_WORKSPACE_ID=1
# LNN_PUSH=0

# --- LeadPilot v3 pipeline (python leadpilot_single.py / python -m backend.leadpilot) ---
# ENRICHMENT_ENABLED=1
# APOLLO_API_KEY=
# SKRAPP_API_KEY=
# LEADPILOT_OUT_XLSX=leadpilot_runs.xlsx
# LEADPILOT_PREFLIGHT=1
