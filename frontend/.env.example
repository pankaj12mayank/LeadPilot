# Preferred: full API base (must match backend API_ROOT_PATH), e.g. /api on the same host as FastAPI.
# Local dev: leave unset → Axios uses ``/api`` and Vite proxies to http://127.0.0.1:8000 (see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8000/api
# Legacy alias (optional):
# VITE_API_URL=http://localhost:8000/api
